# Copy to .env (never commit .env)
# Deployed: same origin as the restaurant site, API under /backend (relative, so one build serves every restaurant)
VITE_BASE_URL=/backend/api/
# Where the API is when the app does not run on a restaurant's own host (localhost, previews): the restaurant code typed
# at login picks it, as https://{code}.{VITE_API_BASE_DOMAIN}/backend/api/. On a restaurant host the API is always the
# same origin (/backend/api/). Leave it empty to use the dev proxy (VITE_DEV_API_ORIGIN) instead.
VITE_API_BASE_DOMAIN=shoof.lambdor.com
# The Restaurant client key sent as X-Api-Key (see docs/FE-API-INTEGRATION-GUIDE.md section 2.1)
VITE_APP_API_KEY=
# Local dev only: where the dev server proxies /backend, and the slug to log in with. Two choices:
#  - a backend running on your machine (dotnet run): https://localhost:7221. It accepts the dev key above
#    (CHANGE_ME_DEV_ONLY_RESTAURANT_API_KEY); /backend is stripped for it, since a local API serves /api at its root.
#  - a deployed restaurant host, e.g. https://{slug}.shoof.lambdor.com. It needs that server's real Restaurant key in
#    VITE_APP_API_KEY (ApiKeys:Clients on the server); with the dev key every call after login answers 403.
VITE_DEV_API_ORIGIN=https://pizzahut.shoof.lambdor.com
VITE_DEV_SLUG=
VITE_APP_I18N_CONFIG_KEY=shoof-restaurant-i18n
VITE_HUB_URL=
